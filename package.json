{
  "name": "globtrek2",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "dev:next": "next dev -H 127.0.0.1 -p 3001 --webpack --disable-source-maps",
    "build": "next build",
    "test": "node --test tests/*.test.mjs",
    "hotels:import": "node scripts/hotels/import-hotels.mjs",
    "hotels:stats": "node scripts/hotels/catalog-stats.mjs",
    "hotels:seed-migration": "node scripts/hotels/generate-legacy-migration.mjs",
    "hotels:enrich": "node scripts/hotels/enrich-hotels.mjs",
    "hotels:google-places": "node scripts/hotels/google-places-match.mjs",
    "hotels:google-places-migration": "node scripts/hotels/generate-google-places-migration.mjs",
    "hotels:prices": "node scripts/hotels/import-price-observations.mjs",
    "activities:import": "node scripts/activities/import-activities.mjs",
    "catalog:readiness": "node scripts/catalog-readiness.mjs",
    "destinations:verify": "node scripts/destinations/verify-wikimedia.mjs",
    "destinations:migration": "node scripts/destinations/generate-migration.mjs",
    "destinations:coverage": "node scripts/destinations/coverage-report.mjs",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@vercel/analytics": "^2.0.1",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4"
  }
}
